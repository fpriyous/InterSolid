{
  "entities": {
    "announcements": {
      "title": "Announcement",
      "description": "Class announcements",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "date": { "type": "string" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "priority", "date", "authorId", "createdAt"]
    },
    "events": {
      "title": "Calendar Event",
      "description": "Events in the class calendar",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "genre": { "type": "string" },
        "time": { "type": "string" },
        "note": { "type": "string" },
        "date": { "type": "string" },
        "authorId": { "type": "string" }
      },
      "required": ["title", "genre", "date", "authorId"]
    },
    "notes": {
      "title": "Meeting Note",
      "description": "Meeting minutes and study materials",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "tag": { "type": "string" },
        "date": { "type": "string" },
        "authorId": { "type": "string" }
      },
      "required": ["title", "content", "tag", "date", "authorId"]
    },
    "polls": {
      "title": "Poll",
      "description": "Digital voting sessions",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "isActive": { "type": "boolean" },
        "totalVotes": { "type": "integer" },
        "authorId": { "type": "string" }
      },
      "required": ["question", "isActive", "totalVotes", "authorId"]
    },
    "aspirasi": {
      "title": "Aspirasi",
      "description": "Anonymous feedback and messages",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "sticker": { "type": "string" },
        "likes": { "type": "integer" },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["likes", "date", "createdAt"]
    },
    "absenTables": {
      "title": "Attendance Table",
      "description": "Table for attendance and dues tracking",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "authorId", "createdAt"]
    },
    "memories": {
      "title": "Memory",
      "description": "Shared class moments (images and videos)",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["image", "video"] },
        "url": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "caption": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "likes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["type", "url", "userId", "createdAt", "likes"]
    },
    "portal_logs": {
      "title": "Portal Log",
      "description": "System-wide activity logs",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "details": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "userId", "createdAt"]
    },
    "spin_logs": {
      "title": "Spin Log",
      "description": "Logs of random wheel spins",
      "type": "object",
      "properties": {
        "winner": { "type": "string" },
        "spunBy": { "type": "string" },
        "spunById": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["winner", "spunById", "createdAt"]
    },
    "table_activity": {
      "title": "Table Activity",
      "description": "Logs for attendance table interactions",
      "type": "object",
      "properties": {
        "tableId": { "type": "string" },
        "rowId": { "type": "string" },
        "colId": { "type": "string" },
        "value": { "type": "boolean" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tableId", "userId", "createdAt"]
    },
    "poll_options": {
      "title": "Poll Option",
      "description": "Options and votes of a poll",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "votes": { "type": "integer" },
        "order": { "type": "integer" }
      },
      "required": ["label", "votes", "order"]
    },
    "memory_comments": {
      "title": "Memory Comment",
      "description": "Comments left on shared class memories",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "userId", "userName", "createdAt"]
    },
    "note_presence": {
      "title": "Note Presence",
      "description": "Real-time user viewing state in a note",
      "type": "object",
      "properties": {
        "noteId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "isTyping": { "type": "boolean" },
        "lastSeen": { "type": "integer" }
      },
      "required": ["noteId", "userId", "userName", "lastSeen"]
    },
    "video_profiles": {
      "title": "Video Profile",
      "description": "Video profiles of class members",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "videoUrl": { "type": "string" },
        "publicId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "videoUrl", "userId", "createdAt"]
    },
    "interlingo_progress": {
      "title": "InterLingo Progress",
      "description": "Language learning progress tracking",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "xp": { "type": "integer" },
        "streak": { "type": "integer" },
        "lastActiveDate": { "type": "string" },
        "completedLessons": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "xp", "streak", "updatedAt"]
    },
    "interlingo_cat_feeds": {
      "title": "InterLingo Cat Feeding Record",
      "description": "Leaderboard and feed tracking for cat mentors",
      "type": "object",
      "properties": {
        "catId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "feedCount": { "type": "integer" },
        "totalXpSpent": { "type": "integer" },
        "lastDish": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["catId", "userId", "userName", "feedCount", "updatedAt"]
    },
    "study_chats": {
      "title": "Study Chat Thread",
      "description": "Chat thread/session with the Auto Paham AI tutor",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "role": { "type": "string" },
              "text": { "type": "string" },
              "timestamp": { "type": "string" }
            },
            "required": ["id", "role", "text", "timestamp"]
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "messages", "createdAt", "updatedAt"]
    },
    "study_knowledge": {
      "title": "Study Knowledge Base",
      "description": "Custom verified knowledge database for the Auto Paham AI tutor",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "content", "createdBy", "createdByName", "createdAt"]
    }
  },
  "firestore": {
    "announcements": { "schema": "announcements", "description": "Global class announcements" },
    "events": { "schema": "events", "description": "Shared calendar events" },
    "notes": { "schema": "notes", "description": "Shared meeting notes" },
    "polls": { "schema": "polls", "description": "Class polls" },
    "polls/{pollId}/options": { "schema": "poll_options", "description": "Options inside a poll" },
    "aspirasi": { "schema": "aspirasi", "description": "Anonymous feedback" },
    "absenTables": { "schema": "absenTables", "description": "Attendance tables" },
    "absenTables/{tableId}/rows": { "schema": "object", "description": "Rows in attendance table" },
    "absenTables/{tableId}/cols": { "schema": "object", "description": "Columns in attendance table" },
    "memories": { "schema": "memories", "description": "Shared class moments" },
    "memories/{memoryId}/comments": { "schema": "memory_comments", "description": "Comments inside a memory" },
    "notes/{noteId}/history": { "schema": "object", "description": "Version history snapshots for notes" },
    "note_presence": { "schema": "note_presence", "description": "Real-time viewer state" },
    "portal_logs": { "schema": "portal_logs", "description": "Global activity logs" },
    "spin_logs": { "schema": "spin_logs", "description": "Wheel spin logs" },
    "table_activity": { "schema": "table_activity", "description": "Attendance table logs" },
    "video_profiles": { "schema": "video_profiles", "description": "Class members video profiles" },
    "interlingo_progress": { "schema": "interlingo_progress", "description": "Student language learning progress" },
    "interlingo_cat_feeds": { "schema": "interlingo_cat_feeds", "description": "Cat mentor feeding leaderboard and interactions" },
    "study_chats": { "schema": "study_chats", "description": "AI Tutor chat sessions per user" },
    "study_knowledge": { "schema": "study_knowledge", "description": "Custom knowledge base for AI grounding" }
  }
}
